{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile stored privately per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Customer display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified customer email address.",
          "minLength": 3,
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Optional profile avatar URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Public verified customer review displayed on the storefront homepage.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the reviewer.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Customer full name.",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Customer role or ordering context (e.g. Repeat Personal Buyer, Clinic Procurement).",
          "minLength": 2,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "description": "Customer city and country.",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "description": "Therapeutic category ordered.",
          "minLength": 2,
          "maxLength": 60
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5."
        },
        "quote": {
          "type": "string",
          "description": "Customer review text detailing order and delivery experience.",
          "minLength": 10,
          "maxLength": 600
        },
        "deliveryDays": {
          "type": "string",
          "description": "Reported transit duration (e.g. 9 business days via ITPS).",
          "minLength": 2,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when review was submitted."
        }
      },
      "required": [
        "authorId",
        "authorName",
        "role",
        "location",
        "category",
        "rating",
        "quote",
        "deliveryDays",
        "createdAt"
      ]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Customer pharmaceutical export quote request persisted per authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "refId": {
          "type": "string",
          "description": "Quote reference code.",
          "minLength": 4,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "description": "Recipient full name.",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Recipient phone number with country code.",
          "minLength": 4,
          "maxLength": 35
        },
        "country": {
          "type": "string",
          "description": "Destination country.",
          "minLength": 2,
          "maxLength": 80
        },
        "addressSummary": {
          "type": "string",
          "description": "Formatted street, city, and zip code.",
          "minLength": 4,
          "maxLength": 250
        },
        "email": {
          "type": "string",
          "description": "Optional contact email.",
          "minLength": 0,
          "maxLength": 150
        },
        "shippingMethod": {
          "type": "string",
          "enum": ["ems", "itps", "triangle"],
          "description": "Selected shipping carrier."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Preferred payment channel.",
          "minLength": 2,
          "maxLength": 50
        },
        "itemCount": {
          "type": "integer",
          "description": "Total packs ordered."
        },
        "itemsSummary": {
          "type": "string",
          "description": "Readable line-item summary.",
          "minLength": 2,
          "maxLength": 1500
        },
        "subtotal": {
          "type": "number",
          "description": "Products subtotal in USD."
        },
        "shippingCharge": {
          "type": "number",
          "description": "Shipping charge in USD."
        },
        "usaTariff": {
          "type": "number",
          "description": "10% USA tariff in USD when applicable."
        },
        "grandTotal": {
          "type": "number",
          "description": "Estimated total in USD."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "userId",
        "refId",
        "fullName",
        "phone",
        "country",
        "addressSummary",
        "shippingMethod",
        "paymentMethod",
        "itemCount",
        "itemsSummary",
        "subtotal",
        "shippingCharge",
        "usaTariff",
        "grandTotal",
        "createdAt"
      ]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Customer product inquiry submitted via the Contact page.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Sender name.",
          "minLength": 1,
          "maxLength": 100
        },
        "country": {
          "type": "string",
          "description": "Sender country.",
          "minLength": 2,
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "description": "Sender phone number.",
          "minLength": 4,
          "maxLength": 35
        },
        "email": {
          "type": "string",
          "description": "Optional email.",
          "minLength": 0,
          "maxLength": 150
        },
        "product": {
          "type": "string",
          "description": "Requested pharmaceutical product.",
          "minLength": 1,
          "maxLength": 150
        },
        "quantity": {
          "type": "string",
          "description": "Requested quantity.",
          "minLength": 1,
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "description": "Optional inquiry note.",
          "minLength": 0,
          "maxLength": 600
        },
        "canCall": {
          "type": "boolean",
          "description": "Whether the customer allows phone follow-up."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "userId",
        "name",
        "country",
        "phone",
        "product",
        "quantity",
        "canCall",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents keyed by Firebase Auth UID."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Public verified customer reviews shown on the DK MEDIMART homepage."
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Submitted export quote requests owned by authenticated customers."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Customer inquiries submitted from the Get in Touch form."
    }
  }
}
